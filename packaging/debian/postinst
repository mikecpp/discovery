#!/bin/sh
# postinst for the discovery Debian package: grant CAP_NET_RAW so the
# scanner can send ICMP echo requests without root. No service is installed.
set -e

case "$1" in
    configure)
        if command -v setcap >/dev/null 2>&1; then
            if ! setcap cap_net_raw+ep /usr/bin/discovery; then
                echo "setcap failed; discovery will fall back to the system ping command" >&2
            fi
        else
            echo "setcap not found; discovery will fall back to the system ping command" >&2
        fi
        ;;
esac

exit 0
