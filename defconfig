#
# Components
#
CONFIG_COMPONENT_WEBSERVER=y
CONFIG_WEBSERVER_ADDRESS="0.0.0.0"
CONFIG_WEBSERVER_PORT=8080
CONFIG_WEBSERVER_TITLE="Device Discovery"
CONFIG_WEBSERVER_OPEN_BROWSER=y
CONFIG_COMPONENT_ICMP=y
CONFIG_ICMP_TIMEOUT_MS=1000
CONFIG_ICMP_DATA_SIZE=56
CONFIG_ICMP_EXTERNAL_FALLBACK=y
CONFIG_ICMP_EXTERNAL_COMMAND="/usr/bin/ping"
# end of Components

#
# Discovery
#
CONFIG_DISCOVERY=y
CONFIG_DISCOVERY_INTERFACE=""
CONFIG_DISCOVERY_THREADS=32
CONFIG_DISCOVERY_MAX_HOSTS=4096
CONFIG_DISCOVERY_WATCH_INTERVAL=5
CONFIG_DISCOVERY_RESCAN_INTERVAL=120
CONFIG_DISCOVERY_OFFLINE_MISSES=2
CONFIG_DISCOVERY_IDENTIFY=y
CONFIG_DISCOVERY_PROBE_TIMEOUT_MS=500
CONFIG_DISCOVERY_RESOLVE_NAMES=y
# end of Discovery
