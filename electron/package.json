{
  "name": "device-discovery",
  "productName": "Device Discovery",
  "version": "1.0.0",
  "description": "Discovers devices on the local subnet and watches their status.",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "build": {
    "appId": "com.discovery.device-discovery",
    "productName": "Device Discovery",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**/*",
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "linux": {
      "category": "Network",
      "target": ["deb", "AppImage"],
      "maintainer": "Device Discovery"
    },
    "win": {
      "target": ["nsis"]
    }
  }
}
